# Application configuration. Leave credentials empty for the safe setup state.
# Public: safe to include in browser bundles; use development values locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only origin used to construct links; set the actual HTTPS origin in production.
APP_URL=http://127.0.0.1:3000

# Netlify production: netlify (provider connection IP header).
# Other trusted ingress that replaces x-forwarded-for: 1. Local default: 0.
TRUST_PROXY=0

# Server-only elevated key. Never prefix with NEXT_PUBLIC_ or expose to clients.
# Used only by narrowly scoped server operations/provisioning that require it.
SUPABASE_SECRET_KEY=

# Server-only migration connection; never used by browser code.
DATABASE_URL=

# Notifications intentionally omitted until a provider is selected.
# Business settings belong in PostgreSQL, not environment variables.

# Optional connected browser tests. Use only a separate disposable test project.
# Keep this false/empty for normal development and for production.
E2E_DATABASE_ISOLATED=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
