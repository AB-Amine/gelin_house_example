    "catalogue:import": "node --env-file-if-exists=.env.local scripts/import-catalogue.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "owner:create": "node --env-file-if-exists=.env.local scripts/provision-owner.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
