    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
